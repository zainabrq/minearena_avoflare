{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://avoflare-api.onrender.com/api/:path*" },
    { "source": "/fhir/:path*", "destination": "https://avoflare-api.onrender.com/fhir/:path*" },
    { "source": "/assets/:path*", "destination": "https://avoflare-api.onrender.com/assets/:path*" },
    { "source": "/static/:path*", "destination": "/:path*" },
    { "source": "/patient", "destination": "/patient.html" },
    { "source": "/", "destination": "/app.html" }
  ]
}
